<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/back"
        app:title="@string/open_map"
        app:titleTextColor="@color/on_surface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Feature 5: expand/collapse the control card so the map can fill the screen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExpandMap"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_fullscreen"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:contentDescription="@string/map_expand" />
    </FrameLayout>

    <!-- Bottom control surface: two titled sections (座標傳送 / 移動巡航) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapControlCard"
        style="@style/Widget.GpsJoystick.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardElevation="3dp"
        app:contentPadding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Section A: 座標傳送 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_coord_teleport"
                android:textAppearance="@style/TextAppearance.GpsJoystick.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/coordInputLayout"
                    style="@style/Widget.GpsJoystick.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/coordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:imeOptions="actionGo"
                        android:maxLines="1"
                        android:hint="@string/hint_coord" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPasteCoord"
                    style="@style/Widget.GpsJoystick.Button.Outlined"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:icon="@drawable/ic_content_paste"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/on_surface"
                    android:contentDescription="@string/paste_coord" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavSave"
                    style="@style/Widget.GpsJoystick.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/fav_save_coord" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavList"
                    style="@style/Widget.GpsJoystick.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/fav_browse" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCoordGo"
                style="@style/Widget.GpsJoystick.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/coord_send" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/outline" />

            <!-- ===== Section B: 移動巡航 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/section_cruise"
                android:textAppearance="@style/TextAppearance.GpsJoystick.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportGpx"
                style="@style/Widget.GpsJoystick.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/gpx_load" />

            <!-- Batch 1: 3-way playback mode selector (segmented, full width) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeOnce"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/mode_chip_once" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeLoop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/mode_chip_loop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeReverse"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/mode_chip_reverse" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Feature 1: speed presets 走/跑/車/自訂 (segmented, full width) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/speedToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeedWalk"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/speed_preset_walk" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeedCycle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/speed_preset_cycle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeedDrive"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/speed_preset_drive" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeedCustom"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/speed_preset_custom" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/speedValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.GpsJoystick.Mono" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    style="@style/Widget.GpsJoystick.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    android:text="@string/pb_start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopPlayback"
                    style="@style/Widget.GpsJoystick.Button.Destructive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/stop_playback" />
            </LinearLayout>

            <!-- Feature 3: slim progress bar is the sole (non-textual) playback indicator. -->
            <ProgressBar
                android:id="@+id/hudProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/status_active"
                android:progressBackgroundTint="@color/outline" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
