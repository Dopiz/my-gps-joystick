<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App logo, centred at the very top; rounded-square clip like a launcher icon. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/logoImage"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GpsJoystick.Logo"
            android:contentDescription="@string/app_name" />

        <!-- Permissions — reordered at runtime: first section while any gate is
             missing, moved to the bottom once all three are granted. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/permissionsCard"
            style="@style/Widget.GpsJoystick.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_permissions"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Title" />

                    <!-- Green check, shown only when all three gates are granted. -->
                    <ImageView
                        android:id="@+id/permissionsCheck"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_step_done"
                        android:visibility="gone"
                        android:contentDescription="@string/section_permissions" />
                </LinearLayout>

                <!-- One row per permission: description on the left, a right-aligned action
                     button on the right. All three buttons share a fixed width so their left
                     edges line up as a neat right-hand column. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:text="@string/perm_desc_location"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantLocation"
                        style="@style/Widget.GpsJoystick.Button.TonalSmall"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/grant_location" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:text="@string/perm_desc_mock"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetMockApp"
                        style="@style/Widget.GpsJoystick.Button.TonalSmall"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/set_mock_app" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:text="@string/perm_desc_overlay"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantOverlay"
                        style="@style/Widget.GpsJoystick.Button.TonalSmall"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/grant_overlay" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Position + primary actions -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GpsJoystick.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_position"
                    android:textAppearance="@style/TextAppearance.GpsJoystick.Title"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_error"
                    android:textAppearance="@style/TextAppearance.GpsJoystick.Body"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMockToggle"
                    style="@style/Widget.GpsJoystick.Button.Cta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/start_mock" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenMap"
                        style="@style/Widget.GpsJoystick.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/open_map" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGpx"
                        style="@style/Widget.GpsJoystick.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/gpx_manage" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 連點設定：三組預設點位，可在 App 內錄製 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GpsJoystick.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_autotap"
                    android:textAppearance="@style/TextAppearance.GpsJoystick.Title"
                    android:paddingBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tapSlotLabel1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <TextView
                        android:id="@+id/tapSlotStatus1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordTap1"
                        style="@style/Widget.GpsJoystick.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/autotap_record" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tapSlotLabel2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <TextView
                        android:id="@+id/tapSlotStatus2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordTap2"
                        style="@style/Widget.GpsJoystick.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/autotap_record" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tapSlotLabel3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <TextView
                        android:id="@+id/tapSlotStatus3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/TextAppearance.GpsJoystick.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordTap3"
                        style="@style/Widget.GpsJoystick.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/autotap_record" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
